# Скопируйте в .env (необязательно: без файла работают значения по умолчанию из compose.base.yaml)
POSTGRES_DB=room_assets
POSTGRES_USER=room_assets
POSTGRES_PASSWORD=room_assets

# Секрет подписи JWT. В dev подставляется фиксированный, для прода задайте длинную случайную строку
# JWT_SECRET=

# Почта. По умолчанию письма уходят в SMTP-заглушку mailpit: веб-интерфейс http://localhost:8025
# Для реального SMTP раскомментируйте и заполните:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Room & Assets <no-reply@example.com>

# Пароли демо-пользователей из сида (admin@example.com и user@example.com)
# SEED_ADMIN_PASSWORD=admin123
# SEED_USER_PASSWORD=user123
